# ============================================================
# EyeKart Backend Environment Configuration Template
# Copy this file to backend/.env and provide your values.
# NEVER commit the actual .env file with secrets to Git.
# ============================================================

# Application Environment
NODE_ENV=production
PORT=5000

# Database Connection (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=eyekart_db

# Managed Database SSL/TLS (Required for Aiven, AWS RDS, DigitalOcean)
# Set DB_SSL=true for managed cloud databases with TLS enforced.
DB_SSL=false
# Optional: Path to custom CA certificate file or inline PEM string
DB_SSL_CA=
# Optional: Set to false ONLY if using self-signed certs (Defaults to true)
DB_SSL_REJECT_UNAUTHORIZED=true

# Security & Authentication
# Generate a cryptographically random 64-character secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# CORS Whitelist (Comma-separated for multiple origins, e.g. https://eyekart.com,https://admin.eyekart.com)
FRONTEND_URL=http://localhost:5174

# Prescription Storage (Optional Persistent Disk Mount Path for Cloud Containers)
# Leave blank for default local uploads directory: backend/uploads/prescriptions
PRESCRIPTION_UPLOAD_DIR=

# Razorpay Payment Gateway (Test Mode Credentials for Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
