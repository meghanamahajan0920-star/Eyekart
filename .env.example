# ============================================================
# EyeKart Environment Configuration Template
# (Copy values to backend/.env and frontend/.env as appropriate)
# ============================================================

# --- Backend Configuration (backend/.env) ---
NODE_ENV=production
PORT=5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=eyekart_db

# Managed Database SSL (Aiven, AWS RDS, DigitalOcean)
DB_SSL=false
# Optional CA bundle path or inline PEM content
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# CORS Whitelist (Comma-separated for multi-origin)
FRONTEND_URL=http://localhost:5174

# Prescription Storage (Optional Persistent Disk Mount Path for Cloud Containers)
PRESCRIPTION_UPLOAD_DIR=

# Razorpay Payment Gateway (Test Mode / Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- Frontend Configuration (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:5000
